// The whole workflow against the live ClinGen Allele Registry: MT over the 'genes' windows of the
// UCSC mini tables (one window, chrM 3009-5731, around MT-ND1 and MT-ND2), ClinVar from
// tests/data/clinvar_mini.vcf.gz (7 MT sites), and the genome built from chrM.fa.gz, both read
// from a UCSC mirror laid out under the test's output directory. It makes one region request and
// one lookup, both read-only. It also checks index/metadata.json and keys/ on that run, and
// rebuilds the index from keys/ with tests/check_rebuild.sh.
//
// Outside tests/ on purpose (Ruling R10): nf-test 0.9.5 cannot leave out a tag, and a plain
// `nf-test test` must stay offline. Run it explicitly, from pipeline/:
//   nf-test test tests-network/workflow_mt.nf.test

nextflow_pipeline {

    name    "pipeline: a real MT run against the live Registry"
    script  "main.nf"
    tag     "network"

    test("MT run against the live Registry passes the publish gate") {
        when {
            params {
                chrom       = "MT"
                regions     = "genes"
                clinvar_vcf = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                ucsc_base   = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir      = "${outputDir}/results"
            }
        }
        then {
            assert workflow.success
            def results = "${outputDir}/results"
            assert path("${results}/reports/summary.md").text.contains('Gate: passed')

            def lines = path("${results}/reports/reach_MT.txt").readLines()
            def reach = lines.takeWhile { !it.startsWith('class\t') }.collectEntries { it.split('\t') as List }
            assert (reach.keys as long) > 1000   // the Registry holds thousands of alleles in 2.7 kb of chrM
            // What the gate enforces: no key whose record finds another CA ID or none, names a REF
            // the genome disagrees with, or is refused by the lookup. Every other key must be
            // reachable, but for the two outcomes reach only counts: reference alleles, and keys no
            // VCF record the lookup takes can name.
            ['wrong_ca', 'not_found', 'ref_mismatch', 'unsupported'].each {
                assert reach[it] == '0'
            }
            assert (reach.reachable as long) == (reach.keys as long) - (reach.reference as long) - (reach.unparseable as long)
            // include_reference is off, so the index holds no reference allele: enumerate drops
            // those written '=' and those written as a delins that puts back the reference's bases
            // (13 in this window on 2026-10-24, e.g. m.3105_3106delinsAC). Stricter than the gate on
            // purpose: it is the run's own contract.
            assert reach.reference == '0'
            // The unparseable keys here are the alleles at the N the rCRS keeps at 3107: m.3107N>A,
            // C, G and T, and deletions spanning it (m.3107del, m.3089_3120del, m.3107_3152del),
            // 7 on 2026-10-24. Any other kind showing up among the examples is worth a look.
            def unparseable = lines.findAll { it.startsWith('unparseable: ') }
            assert unparseable.size() == Math.min(5, reach.unparseable as int)   // reach shows 5 an outcome
            unparseable.each {
                assert it ==~ /unparseable: NC_012920\.1:m\.3107N>[ACGT] CA\d+ \(unsupported edit\)/ ||
                    it.endsWith(' (reference sequence there is not ACGT)')
            }

            def coverage = path("${results}/reports/coverage.tsv").readLines()
            assert coverage.any { it ==~ /MT\tregistry\talleles\t[1-9]\d*/ }
            assert coverage.contains('MT\tregistry\twindows\t1')
            assert coverage.contains('MT\tclinvar\tsites\t7')
            assert coverage.contains('MT\tharvest\tregistered\t7')

            def manifest = new groovy.json.JsonSlurper().parse(new File("${results}/index/manifest.json"))
            // the UTC day ENUMERATE asked the Registry, as it recorded it
            def today = java.time.LocalDate.now(java.time.ZoneOffset.UTC)
            assert manifest.sources == ["registry_genes_${today}".toString(), 'clinvar_2026-10-19']
            assert manifest.harvest_date == today.toString()
            assert manifest.genome == '../genome/GRCh38.bin'
            assert path("${results}/reports/validate_MT.txt").readLines().contains('m\t7\t7\t100.0')

            // The shard the index was built from, and index/metadata.json, on a real Registry run.
            def shard = "${results}/keys/NC_012920.1.tsv.gz"
            assert new File("${results}/keys").list().toList() == ['NC_012920.1.tsv.gz']
            assert TestFiles.lines(shard).size() == manifest.entries
            def meta = new groovy.json.JsonSlurper().parse(new File("${results}/index/metadata.json"))
            assert meta.format_version == 1
            assert meta.registry.base_url == 'https://reg.genome.network'
            assert meta.registry.registry_date == today.toString()
            assert meta.regions.set == 'genes'
            assert meta.regions.windows == 1
            assert meta.sources.downloads*.source == ['ucsc_ncbiRefSeq', 'ucsc_knownGene', 'clinvar']
            assert meta.sources.genome.built == true
            assert meta.outputs.entries == manifest.entries
            assert meta.outputs.index['caid.fst'].md5 == TestFiles.md5("${results}/index/caid.fst")
            assert meta.outputs.keys == [[
                file: 'NC_012920.1.tsv.gz', md5: TestFiles.md5(shard), size: new File(shard).length(),
                tsv_md5: TestFiles.gunzippedMd5(shard), tsv_size: TestFiles.lines(shard).sum { it.length() + 1 },
                lines: manifest.entries,
            ]]
            assert meta.checks.gate.passed == true
            assert meta.checks.per_chromosome.MT['index:keys'] == manifest.entries
            assert meta.rebuild.argv[-3..-1] == ['--genome', 'genome/GRCh38.bin', '--genome-relative']

            // The index rebuilt from keys/ in another directory, byte for byte.
            def proc = ['bash', "${projectDir}/tests/check_rebuild.sh", results].execute()
            def out = new StringBuilder()
            def err = new StringBuilder()
            proc.waitForProcessOutput(out, err)
            assert proc.exitValue() == 0 : err.toString()
        }
    }
}
