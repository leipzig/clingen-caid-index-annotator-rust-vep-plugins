// -profile host (add-on, list it last, e.g. -profile local,host): no container. Tasks run
// clingen-index, curl, gawk, gzip, openssl and coreutils from the PATH of the machine that
// executes them; for a checkout, `cargo build --release -p clingen-index` and put
// target/release on PATH.

process.container = null

docker.enabled       = false
podman.enabled       = false
apptainer.enabled    = false
singularity.enabled  = false
charliecloud.enabled = false
