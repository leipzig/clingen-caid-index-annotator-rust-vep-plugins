// -profile awsbatch: AWS Batch, the image in ECR, the work directory in S3.
// Pass the work directory on the command line: -work-dir s3://<bucket>/work (it must be in S3
// and include a sub-directory). docs/aws-batch.md sets up the queue, bucket and repository.

process {
    executor  = 'awsbatch'
    queue     = params.aws_queue      // job queue name or ARN (stack output JobQueueName)
    container = params.container      // <account>.dkr.ecr.<region>.amazonaws.com/clingen-index:0.1.0
}

aws {
    region = params.aws_region        // Nextflow also passes it to the task's CLI as `aws --region ...`
    batch {
        // No cliPath: AWS CLI v2 is in the image (/usr/local/bin/aws) and found on PATH.
        // Setting cliPath would make Nextflow mount the host's directory over the image's.
        maxParallelTransfers = 4      // per job
        maxSpotAttempts      = 3      // default 0; lets Batch retry a task whose Spot instance was reclaimed
    }
    client {
        maxConnections = 50           // the launcher's S3 client
    }
}
