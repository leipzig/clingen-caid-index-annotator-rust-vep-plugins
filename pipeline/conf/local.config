// -profile local: this machine, every task in the clingen-index image under Docker.
// Docker Desktop and Colima share only parts of the host with containers (Colima: $HOME),
// so the work directory and every input must live there.

process.executor = 'local'

// The local executor refuses a task that asks for more memory or CPUs than this machine has,
// and the sort label asks for 16 GB and 4 CPUs. resourceLimits lowers every larger request to
// these instead, so a 16 GB, 2-CPU laptop runs the chr21 example (whose largest task peaked at
// 1.9 GB). On a larger machine, raise them with -c and a file holding, say,
// process.resourceLimits = [cpus: 8, memory: 48.GB]. ENUMERATE's 4 GB stays under them.
process.resourceLimits = [cpus: 2, memory: 12.GB]

docker {
    enabled    = true
    // Run as the invoking user, so the work and results files are not owned by root.
    runOptions = '-u $(id -u):$(id -g)'
}
