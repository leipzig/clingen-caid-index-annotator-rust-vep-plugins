// -profile local: this machine, every task in the clingen-index image under Docker.
// Docker Desktop and Colima share only parts of the host with containers (Colima: $HOME),
// so the work directory and every input must live there.

process.executor = 'local'

docker {
    enabled    = true
    // Run as the invoking user, so the work and results files are not owned by root.
    runOptions = '-u $(id -u):$(id -g)'
}
