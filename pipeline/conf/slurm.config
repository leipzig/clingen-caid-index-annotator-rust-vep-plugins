// -profile slurm: a SLURM cluster with Apptainer and a shared filesystem for the work directory.

process {
    executor = 'slurm'
    queue    = params.slurm_queue
    // Apptainer needs a scheme to know where an image comes from; a plain registry name such
    // as ghcr.io/<you>/clingen-index:0.1.0 is a Docker image. An absolute path (a .sif on the
    // shared filesystem) is used as it is.
    container = (params.container ==~ /^[A-Za-z][A-Za-z0-9+.-]*:\/\/.*/ || params.container.startsWith('/'))
        ? params.container
        : "docker://${params.container}"

    // Compute nodes often have no internet; downloads and Registry calls can go to a
    // partition that does.
    withLabel: network {
        queue = params.network_queue ?: params.slurm_queue
    }
    // Every other task takes minutes, so the partition's default time limit does. GNOMAD_SITES
    // streams a multi-GB gnomAD VCF per chromosome through gzip and awk, for hours, and on a
    // partition whose default is shorter would be killed, retried and killed again.
    withName: GNOMAD_SITES {
        time = 24.h
    }
}

apptainer {
    enabled    = true
    autoMounts = true
}
