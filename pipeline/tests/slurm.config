// Test-only settings for run_slurm_shim.sh, passed as `-c` together with -profile slurm,host.
// Plain executor.* keys on purpose: in Nextflow 26.04.7 the documented `executor { $slurm { } }`
// form works but logs "Unrecognized config option" for every key (nextflow-io/nextflow#7551,
// fixed in 26.10.0).

executor {
    // The defaults are made for a cluster: poll every 5 s, cache squeue for 1 min, wait 270 s
    // for a job that left the queue without an .exitcode. The shims answer at once, so the
    // run waits for these instead of for work.
    queueStatInterval = '2s'
    pollInterval      = '1s'
    exitReadTimeout   = '30s'
}

// A stub run keeps the container settings, and this test has no Apptainer. -profile
// slurm,host already turns it off (the strict parser applies profiles in -profile order);
// this line also covers NXF_SYNTAX_PARSER=v1, where the order of definition decides.
apptainer.enabled = false
