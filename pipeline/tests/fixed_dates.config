// Test-only, for the workflow test that dates the manifest by its Registry tasks: ENUMERATE
// sees the UTC day 2026-10-03 and LOOKUP 2026-10-01, as if they had run on other days than the
// run itself (as tasks a -resume reuses did). `date -u +%F` is what each task asks; any other
// date call goes to the real one, which the task wrapper itself uses for its timings. The
// function is exported from beforeScript, which runs in the wrapper's shell before the script.

process {
    withName: ENUMERATE {
        beforeScript = 'date() { if [[ "$*" == "-u +%F" ]]; then echo 2026-10-03; else command date "$@"; fi; }; export -f date'
    }
    withName: LOOKUP {
        beforeScript = 'date() { if [[ "$*" == "-u +%F" ]]; then echo 2026-10-01; else command date "$@"; fi; }; export -f date'
    }
}
