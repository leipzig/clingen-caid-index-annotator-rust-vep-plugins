// The whole workflow, for real and offline: MT over the two windows of tests/data/regions_MT.bed,
// ClinVar from tests/data/clinvar_mini.vcf.gz (7 MT sites), the genome built from a UCSC mirror
// laid out under the test's output directory (bigZips/hg38.fa.gz is chrM.fa.gz), and
// MockRegistry (tests/lib) on 127.0.0.1 standing in for the Registry: it knows the 58 registered
// alleles of tests/data/pairs_MT.tsv plus two reference alleles (one written `=`, one a delins that
// puts back the reference's bases, as the live Registry holds some), and answers lookups from
// tests/data/harvest_MT.tsv. A published run carries keys/ and index/metadata.json, and
// tests/check_rebuild.sh rebuilds its index from them byte for byte.
// tests-network/workflow_mt.nf.test runs MT against the real Registry.

nextflow_pipeline {

    name    "pipeline: a real MT run against a stand-in Registry"
    script  "main.nf"
    tag     "pipeline"

    // A made-up CA ID: reach counts reference keys without looking them up.
    def reference = ['NC_012920.1:m.3307A=', 'CA9000000001']
    // Real (CA2499563283, chrM 3105-3106 is AC): only its coordinates say it changes nothing.
    def noOpDelins = ['NC_012920.1:m.3105_3106delinsAC', 'CA2499563283', 'AC', 'AC']
    // The UTC day the Registry tasks run, which they record for the manifest's dates.
    def today = java.time.LocalDate.now(java.time.ZoneOffset.UTC).toString()

    // The registry and its alleles; withAlleles false gives a Registry whose region query finds nothing.
    def startRegistry = { String projectDir, boolean withAlleles ->
        def pairs = withAlleles ? TestFiles.rows("${projectDir}/tests/data/pairs_MT.tsv") + [reference, noOpDelins] : []
        new MockRegistry(pairs, TestFiles.rows("${projectDir}/tests/data/harvest_MT.tsv"))
    }

    // The script of each ENUMERATE task, from the work directories.
    def enumerateCommands = { String workDir ->
        def commands = []
        new File(workDir).eachFileRecurse { f ->
            if (f.name == '.command.sh' && f.text.contains('clingen-index registry enumerate')) {
                commands << f.text
            }
        }
        commands
    }

    def reachCounts = { String file ->
        path(file).readLines().takeWhile { !it.startsWith('class\t') }.collectEntries { it.split('\t') as List }
    }

    // tests/check_rebuild.sh on a run's outdir: [exit status, its stderr]. It rebuilds the index from
    // keys/ in a temporary directory with clingen-index from PATH (as the host profile has it).
    // env: variables added to the test's environment, such as GENOME_STANDIN.
    def checkRebuild = { String projectDir, String results, Map env = [:] ->
        def vars = (System.getenv() + env).collect { k, v -> "${k}=${v}".toString() }
        def proc = ['bash', "${projectDir}/tests/check_rebuild.sh", results].execute(vars, null)
        def out = new StringBuilder()
        def err = new StringBuilder()
        proc.waitForProcessOutput(out, err)
        [proc.exitValue(), err.toString()]
    }

    // The command line and a params file give the strict parser Strings: 'false' must stay false.
    test("MT run publishes an index of the enumerated and harvested alleles, without reference alleles") {
        def registry
        when {
            registry = startRegistry(projectDir, true)
            params {
                chrom             = "MT"
                regions           = "${projectDir}/tests/data/regions_MT.bed"
                clinvar_vcf       = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                include_reference = "false"
                allow_mismatches  = "false"
                registry_url      = registry.url
                ucsc_base         = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir            = "${outputDir}/results"
            }
        }
        then {
            assert workflow.success
            def results = "${outputDir}/results"

            // two windows: one GET each; the 7 ClinVar MT sites: one POST
            assert registry.requests.count { it.startsWith('GET /alleles?refseq=NC_012920.1&') } == 2
            assert registry.requests.count { it.startsWith('POST /alleles?file=vcf&') } == 1
            def commands = enumerateCommands("${launchDir}/work")
            assert commands.size() == 1
            assert !commands[0].contains('--keep-reference')

            def manifest = new groovy.json.JsonSlurper().parse(new File("${results}/index/manifest.json"))
            assert manifest.sources == ["registry_bed_${today}".toString(), 'clinvar_2026-10-19']
            assert manifest.harvest_date == today
            assert manifest.genome == '../genome/GRCh38.bin'
            assert manifest.entries == 58
            assert path("${results}/index/caid.fst").exists()
            assert path("${results}/genome/GRCh38.bin").exists()
            assert path("${results}/genome/GRCh38.bin.idx").exists()

            assert TestFiles.lines("${results}/harvest/MT.tsv.gz").size() == 7
            assert reachCounts("${results}/reports/reach_MT.txt") == [
                keys: '58', reachable: '58', wrong_ca: '0', not_found: '0', ref_mismatch: '0',
                unsupported: '0', reference: '0', unparseable: '0',
            ]
            assert path("${results}/reports/validate_MT.txt").readLines().contains('m\t7\t7\t100.0')
            def coverage = path("${results}/reports/coverage.tsv").readLines()
            assert coverage.contains('MT\tregistry\twindows\t2')
            assert coverage.contains('MT\tregistry\talleles\t58')
            assert coverage.contains('MT\tclinvar\tsites\t7')
            assert coverage.contains('MT\tclinvar\tskipped\t1')
            assert coverage.contains('MT\tindex\tkeys\t58')
            assert path("${results}/reports/summary.md").text.contains('Gate: passed')
            assert path("${results}/reports/sources.tsv").readLines().any { it.startsWith('clinvar\t') }
            assert TestFiles.lines("${results}/reports/skipped.tsv.gz") == [
                'dataset\tCHROM\tPOS\tID\tREF\tALT\treason', 'clinvar\tMT\t1438\t177708\tA\t.\tno_alt',
            ]

            // keys/: the one shard the index was built from, as KEYS wrote it (the 58 pairs), gzipped
            assert new File("${results}/keys").list().toList() == ['NC_012920.1.tsv.gz']
            def shard = "${results}/keys/NC_012920.1.tsv.gz"
            assert TestFiles.lines(shard) == path("${projectDir}/tests/data/pairs_MT.tsv").readLines()

            // index/metadata.json: every part, checked against the published files
            def meta = new groovy.json.JsonSlurper().parse(new File("${results}/index/metadata.json"))
            assert meta.format_version == 1
            assert meta.pipeline.git_commit ==~ /[0-9a-f]{40}/
            assert meta.pipeline.git_dirty instanceof Boolean
            assert meta.pipeline.source_digest ==~ /[0-9a-f]{64}/
            assert meta.pipeline.nextflow_version == '26.04.7'
            assert meta.pipeline.command_line.startsWith('nextflow')
            assert meta.pipeline.profile == 'host'
            // as Nextflow lists them: nf-test also passes nextflow.config with -c, so it is there twice
            assert meta.pipeline.config_files.toSet() == ["${projectDir}/nextflow.config", "${projectDir}/tests/nextflow.config"]*.toString().toSet()
            assert meta.pipeline.project_dir == projectDir.toString()
            ['run_name', 'session_id', 'launch_dir', 'work_dir', 'start', 'written'].each { assert meta.pipeline[it] }
            assert meta.pipeline.containsKey('container') && meta.pipeline.container_engine == null
            assert meta.tool.clingen_index_version == 'clingen-index --version'.execute().text.trim()
            // the binary DIGEST ran (PATH's, under the host profile), and the image's build inputs here
            def bin = ['bash', '-c', 'command -v clingen-index'].execute().text.trim()
            assert meta.tool.clingen_index_path == bin
            assert meta.tool.clingen_index_sha256 == TestFiles.digest('SHA-256', new File(bin).bytes)
            assert meta.tool.platform == ['uname', '-sm'].execute().text.trim()
            assert meta.tool.build_source.root == new File(projectDir.toString()).parent
            assert meta.tool.build_source.digest ==~ /[0-9a-f]{64}/
            assert meta.tool.build_source.files*.path.containsAll(['Cargo.lock', 'Dockerfile', 'crates/clingen-index/Cargo.toml'])
            assert meta.tool.vareffect_version == manifest.vareffect_version
            assert meta.params.chrom == 'MT'
            assert meta.params.registry_url == registry.url
            assert meta.params.include_reference == 'false'
            def bed = "${projectDir}/tests/data/regions_MT.bed"
            assert meta.regions.bed == [name: 'regions_MT.bed', path: bed, md5: TestFiles.md5(bed)]
            assert [meta.regions.pad, meta.regions.merge_gap, meta.regions.max_window, meta.regions.flank] == [20, 5000, 50000, 200]
            assert meta.regions.chromosomes == ['MT']
            assert meta.regions.windows == 2
            assert meta.regions.per_chromosome.MT.windows == 2
            assert meta.registry.base_url == registry.url
            assert meta.registry.registry_date == today
            assert meta.registry.harvest_date == today
            assert [meta.registry.page_size, meta.registry.split_overlap, meta.registry.include_reference] == [200000, 1000, false]
            def sources = path("${results}/reports/sources.tsv").readLines()
            assert meta.sources.downloads.size() == sources.size() - 1
            assert meta.sources.downloads*.source == sources.drop(1).collect { it.tokenize('\t')[0] }
            assert meta.sources.clinvar.release == '2026-10-19'
            assert meta.sources.gnomad == null
            assert meta.sources.genome.built == true
            assert meta.sources.genome.fasta.md5 == TestFiles.md5("${projectDir}/tests/data/chrM.fa.gz")
            assert meta.sources.genome.fasta.url.endsWith('/bigZips/hg38.fa.gz')
            assert meta.sources.genome.files.collectEntries { [it.name, it.md5] } == [
                'GRCh38.bin': TestFiles.md5("${results}/genome/GRCh38.bin"),
                'GRCh38.bin.idx': TestFiles.md5("${results}/genome/GRCh38.bin.idx"),
            ]
            assert meta.cache.directories == []
            assert meta.outputs.index['caid.fst'] == [size: new File("${results}/index/caid.fst").length(), md5: TestFiles.md5("${results}/index/caid.fst")]
            assert meta.outputs.index['manifest.json'].md5 == TestFiles.md5("${results}/index/manifest.json")
            assert meta.outputs.entries == 58
            assert meta.outputs.keys == [[
                file: 'NC_012920.1.tsv.gz', md5: TestFiles.md5(shard), size: new File(shard).length(),
                tsv_md5: TestFiles.gunzippedMd5(shard), tsv_size: TestFiles.lines(shard).sum { it.length() + 1 }, lines: 58,
            ]]
            assert meta.checks.gate.passed == true
            assert meta.checks.statuses == ['reach:MT:0', 'validate:MT:0']
            assert meta.checks.per_chromosome.MT['index:keys'] == 58
            assert meta.checks.keys.MT.enumerated == 58
            assert meta.rebuild.argv == ['clingen-index', 'build', '--sorted', 'keys/NC_012920.1.tsv', '--out', 'index',
                '--source', "registry_bed_${today}".toString(), '--source', 'clinvar_2026-10-19', '--harvest-date', today,
                '--genome', 'genome/GRCh38.bin', '--genome-relative']
            assert meta.rebuild.expected_md5 == ['caid.fst': TestFiles.md5("${results}/index/caid.fst"),
                                                 'manifest.json': TestFiles.md5("${results}/index/manifest.json")]
            assert meta.regenerate.command_line == meta.pipeline.command_line

            // A second build from the shard, in another directory, gives the same bytes as BUILD_INDEX's.
            def (status, err) = checkRebuild(projectDir.toString(), results)
            assert status == 0 : err
            assert err.contains('rebuilt from keys/ byte for byte (1 shard(s))')
            assert err.contains('checked caid.fst byte for byte; manifest.json byte for byte')
            assert err.contains('clingen-index is the binary that built the index')

            // rebuild.steps followed literally, from a directory beside results/, with <outdir> relative.
            def steps = new File("${outputDir}/steps")
            steps.mkdirs()
            def script = (['set -eu'] + meta.rebuild.steps.collect { it.replace('<outdir>', '../results') }).join('\n')
            def proc = ['bash', '-c', script].execute(null, steps)
            def stepsErr = new StringBuilder()
            proc.waitForProcessOutput(new StringBuilder(), stepsErr)
            assert proc.exitValue() == 0 : stepsErr.toString()
            ['caid.fst', 'manifest.json'].each { f ->
                assert TestFiles.md5("${steps}/rebuild/index/${f}") == TestFiles.md5("${results}/index/${f}")
            }

            // A copy as if made with --genome at a path that does not exist on this machine:
            // check_rebuild.sh stops, and with GENOME_STANDIN rebuilds with that file in its place,
            // checking caid.fst byte for byte and manifest.json apart from its genome value.
            def given = "${outputDir}/given"
            new File("${given}/index").mkdirs()
            new File("${given}/keys").mkdirs()
            java.nio.file.Files.copy(new File(shard).toPath(), new File("${given}/keys/NC_012920.1.tsv.gz").toPath())
            java.nio.file.Files.copy(new File("${results}/index/caid.fst").toPath(), new File("${given}/index/caid.fst").toPath())
            def absent = '/no-such-dir/GRCh38.bin'
            def givenManifest = new File("${results}/index/manifest.json").text.replace('"genome": "../genome/GRCh38.bin"', "\"genome\": \"${absent}\"")
            assert givenManifest.contains(absent)
            new File("${given}/index/manifest.json").text = givenManifest
            def givenMeta = new groovy.json.JsonSlurper().parse(new File("${results}/index/metadata.json"))
            givenMeta.rebuild.argv = givenMeta.rebuild.argv.findAll { it != '--genome-relative' }.collect { it == 'genome/GRCh38.bin' ? absent : it }
            givenMeta.rebuild.genome = [recorded: absent, relative: false]
            givenMeta.rebuild.expected_md5['manifest.json'] = TestFiles.md5("${given}/index/manifest.json")
            new File("${given}/index/metadata.json").text = groovy.json.JsonOutput.toJson(givenMeta)
            def (stopped, stopErr) = checkRebuild(projectDir.toString(), given)
            assert stopped == 2 : stopErr
            assert stopErr.contains("records the genome ${absent}, which does not exist here")
            assert stopErr.contains('GENOME_STANDIN')
            def standin = TestFiles.write("${outputDir}/standin/GRCh38.bin", ['not read'])
            def (standinStatus, standinErr) = checkRebuild(projectDir.toString(), given, [GENOME_STANDIN: standin])
            assert standinStatus == 0 : standinErr
            assert standinErr.contains('rebuilt from keys/ with a stand-in genome (1 shard(s))')
            assert standinErr.contains('checked caid.fst byte for byte; manifest.json byte for byte apart from its genome value')
        }
        cleanup {
            registry?.close()
        }
    }

    test("MT run with include_reference keeps the reference alleles and says so in the manifest") {
        def registry
        when {
            registry = startRegistry(projectDir, true)
            params {
                chrom             = "MT"
                regions           = "${projectDir}/tests/data/regions_MT.bed"
                clinvar_vcf       = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                include_reference = "true"
                registry_url      = registry.url
                ucsc_base         = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir            = "${outputDir}/results"
            }
        }
        then {
            assert workflow.success
            def results = "${outputDir}/results"
            def manifest = new groovy.json.JsonSlurper().parse(new File("${results}/index/manifest.json"))
            assert manifest.sources == ["registry_bed_${today}".toString(), 'reference_alleles', 'clinvar_2026-10-19']
            assert manifest.entries == 60
            def commands = enumerateCommands("${launchDir}/work")
            assert commands.size() == 1
            assert commands[0].contains('--keep-reference')
            def reach = reachCounts("${results}/reports/reach_MT.txt")
            // reach counts both reference alleles as such: the delins too, from the genome's bases
            assert reach.keys == '60'
            assert reach.reachable == '58'
            assert reach.reference == '2'
            assert reach.unsupported == '0'
            assert path("${results}/reports/summary.md").text.contains('Gate: passed')
        }
        cleanup {
            registry?.close()
        }
    }

    // The manifest's dates come from the Registry tasks, not from the run's start: a task a -resume
    // reuses keeps the day it ran. tests/fixed_dates.config has ENUMERATE run on 2026-10-03 and
    // LOOKUP on 2026-10-01, so the source is ENUMERATE's day and the harvest date the earlier one.
    test("MT run dates the manifest by the days its Registry tasks ran, not the run's") {
        config "./fixed_dates.config"
        def registry
        when {
            registry = startRegistry(projectDir, true)
            params {
                chrom        = "MT"
                regions      = "${projectDir}/tests/data/regions_MT.bed"
                clinvar_vcf  = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                cache        = "${projectDir}/tests/data/cache"
                registry_url = registry.url
                ucsc_base    = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir       = "${outputDir}/results"
            }
        }
        then {
            assert workflow.success
            def results = "${outputDir}/results"
            assert !['2026-10-01', '2026-10-03'].contains(today)
            def manifest = new groovy.json.JsonSlurper().parse(new File("${results}/index/manifest.json"))
            assert manifest.sources == ['registry_bed_2026-10-03', 'clinvar_2026-10-19']
            assert manifest.harvest_date == '2026-10-01'
            def meta = new groovy.json.JsonSlurper().parse(new File("${results}/index/metadata.json"))
            assert meta.registry.registry_date == '2026-10-03'
            assert meta.registry.harvest_date == '2026-10-01'
            assert meta.rebuild.argv.contains('2026-10-01')
            // tests/data/cache holds chr21 answers only: no MT site is answered from it, but the
            // metadata records the directory and its file all the same
            def chunk = "${projectDir}/tests/data/cache/chunk_00000.tsv"
            assert meta.cache.directories == [[path: "${projectDir}/tests/data/cache".toString(),
                files: [[name: 'chunk_00000.tsv', size: new File(chunk).length(), md5: TestFiles.md5(chunk)]]]]
            assert meta.cache.digest == TestFiles.digest('SHA-256', "${TestFiles.md5(chunk)}  chunk_00000.tsv\n".getBytes('UTF-8'))
            assert checkRebuild(projectDir.toString(), results)[0] == 0
            def summary = path("${results}/reports/summary.md").text
            assert summary.contains('- Registry date: 2026-10-03, the UTC day the earliest ENUMERATE task ran (manifest source registry_bed_2026-10-03)')
            assert summary.contains('- Harvest date: 2026-10-01, the UTC day the earliest ENUMERATE or LOOKUP task ran')
            assert summary.contains('Gate: passed')
        }
        cleanup {
            registry?.close()
        }
    }

    // Ruling R8: windows that enumerate nothing look like a Registry answer that changed shape.
    // FINALIZE refuses to publish; REPORT has run first, so the reports say why.
    test("MT run whose windows enumerate nothing fails before publishing, and still reports") {
        def registry
        when {
            registry = startRegistry(projectDir, false)
            params {
                chrom            = "MT"
                regions          = "${projectDir}/tests/data/regions_MT.bed"
                clinvar_vcf      = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                allow_mismatches = "false"
                registry_url     = registry.url
                ucsc_base        = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir           = "${outputDir}/results"
            }
        }
        then {
            def results = "${outputDir}/results"
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('enumerate MT: 1 windows file(s) gave no allele')
            assert !path("${results}/index").exists()
            assert !path("${results}/genome").exists()
            assert !path("${results}/keys").exists()
            def summary = path("${results}/reports/summary.md").text
            assert summary.contains('Gate: **failed**')
            assert summary.contains('enumerate MT: 1 windows file(s) gave no allele')
            assert path("${results}/reports/coverage.tsv").readLines().contains('MT\tregistry\talleles\t0')
        }
        cleanup {
            registry?.close()
        }
    }

    test("MT run whose windows enumerate nothing publishes with allow_mismatches") {
        def registry
        when {
            registry = startRegistry(projectDir, false)
            params {
                chrom            = "MT"
                regions          = "${projectDir}/tests/data/regions_MT.bed"
                clinvar_vcf      = "${projectDir}/tests/data/clinvar_mini.vcf.gz"
                allow_mismatches = "true"
                registry_url     = registry.url
                ucsc_base        = TestFiles.ucscMirror(projectDir, "${outputDir}/ucsc")
                outdir           = "${outputDir}/results"
            }
        }
        then {
            def results = "${outputDir}/results"
            assert workflow.success
            // the 7 harvested ClinVar alleles only
            assert new groovy.json.JsonSlurper().parse(new File("${results}/index/manifest.json")).entries == 7
            // published with its shard, and a record of the failed check
            assert path("${results}/keys/NC_012920.1.tsv.gz").exists()
            def meta = new groovy.json.JsonSlurper().parse(new File("${results}/index/metadata.json"))
            assert meta.checks.gate.passed == false
            assert meta.checks.gate.allow_mismatches == true
            assert meta.checks.gate.failures == ['enumerate MT: 1 windows file(s) gave no allele (has the Registry answer changed?)']
            assert meta.outputs.keys[0].lines == 7
            assert path("${results}/reports/summary.md").text.contains('FINALIZE publishes index/ anyway (--allow_mismatches)')
        }
        cleanup {
            registry?.close()
        }
    }
}
