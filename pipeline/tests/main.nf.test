nextflow_pipeline {

    name    "pipeline: parameters and stubbed workflow"
    script  "main.nf"
    tag     "pipeline"
    options "-stub"

    // nf-test runs Nextflow with -quiet, so the parameter summary (log.info) is read from the
    // run's log, meta/nextflow.log, not from stdout.

    // Every process of the pipeline, so a stub run can be checked to reach all of them.
    def allProcesses = [
        'FETCH_UCSC', 'REGIONS', 'ENUMERATE',
        'RESOLVE_GNOMAD', 'GNOMAD_SITES', 'CLINVAR_SITES', 'SPLIT_CACHE', 'MERGE_SITES', 'LOOKUP', 'COLLECT',
        'FETCH_FASTA', 'BUILD_GENOME', 'KEYS', 'BUILD_INDEX', 'VALIDATE', 'REACH', 'FINALIZE', 'REPORT',
    ]

    test("help prints the parameters") {
        when {
            params {
                help = true
            }
        }
        then {
            def out = workflow.stdout.join('\n')
            assert workflow.success
            assert out.contains('--chrom')
            assert out.contains('--regions')
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("help lists include_reference") {
        when {
            params {
                help = true
            }
        }
        then {
            assert workflow.success
            assert workflow.stdout.join('\n').contains('--include_reference')
        }
    }

    test("missing chrom fails") {
        when {
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('Missing required parameter(s): chrom')
        }
    }

    test("chrom 23 fails") {
        when {
            params {
                chrom  = "23"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--chrom (23)')
        }
    }

    test("chrom chrUn fails") {
        when {
            params {
                chrom  = "chrUn"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--chrom (chrUn)')
        }
    }

    test("chrom M fails") {
        // UCSC writes chrM and Ensembl MT; a bare M is neither, so it is refused.
        when {
            params {
                chrom  = "M"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--chrom (M)')
        }
    }

    test("unknown param fails") {
        when {
            params {
                chrom  = "21"
                foo    = "x"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--foo')
        }
    }

    // Reference alleles are left out of the index unless asked for. The command line hands
    // the strict parser a String ('true'), a params file a Boolean; both are accepted.
    test("include_reference true is accepted") {
        when {
            params {
                chrom             = "21"
                include_reference = "true"
                outdir            = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name ==~ /.*ENUMERATE \(windows_21_0000\)/ }
        }
    }

    test("include_reference true as a Boolean is accepted") {
        when {
            params {
                chrom             = "21"
                include_reference = true
                outdir            = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name ==~ /.*ENUMERATE \(windows_21_0000\)/ }
        }
    }

    test("include_reference maybe fails") {
        when {
            params {
                chrom             = "21"
                include_reference = "maybe"
                outdir            = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--include_reference (maybe): Value is [string] but should be [boolean]')
        }
    }

    test("chrom chrM is accepted") {
        when {
            params {
                chrom  = "chrM"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert path("$launchDir/meta/nextflow.log").readLines().any { it ==~ /chromosomes\s*: MT/ }
            assert workflow.trace.tasks().any { it.name ==~ /.*ENUMERATE \(windows_MT_0000\)/ }
        }
    }

    // The other accepted forms, each run as the bare GRCh38 name the tasks see. A params-file
    // integer (chrom = 21) arrives typed, unlike the command line's String.
    [chr21: '21', X: 'X', chrX: 'X', MT: 'MT', 21: '21'].each { form, bare ->
        test("chrom ${form} (${form.getClass().simpleName}) is accepted as ${bare}") {
            when {
                params {
                    chrom  = form
                    outdir = "$outputDir"
                }
            }
            then {
                assert workflow.success
                assert path("$launchDir/meta/nextflow.log").readLines().any { it ==~ /chromosomes\s*: ${bare}/ }
                assert workflow.trace.tasks().any { it.name ==~ /.*ENUMERATE \(windows_${bare}_0000\)/ }
            }
        }
    }

    test("stub: chrom 21 runs every process once and publishes") {
        when {
            params {
                chrom    = "21"
                datasets = "clinvar,gnomad_genomes,gnomad_exomes"
                cache    = "${projectDir}/tests/data/cache"
                outdir   = "$outputDir"
            }
        }
        then {
            def counts = workflow.trace.tasks().countBy { it.name.tokenize(' ')[0].tokenize(':')[-1] }
            def expected = allProcesses.collectEntries { [it, 1] } + [GNOMAD_SITES: 2]
            assert workflow.success
            assert path("$launchDir/meta/nextflow.log").readLines().any { it ==~ /chromosomes\s*: 21/ }
            assert counts == expected
            assert path("$outputDir/index/caid.fst").exists()
            assert path("$outputDir/index/manifest.json").exists()
            assert path("$outputDir/genome/GRCh38.bin").exists()
            assert path("$outputDir/genome/GRCh38.bin.idx").exists()
            assert path("$outputDir/harvest/21.tsv.gz").exists()
            ['coverage.tsv', 'summary.md', 'sources.tsv', 'skipped.tsv.gz', 'validate_21.txt', 'reach_21.txt'].each {
                assert path("$outputDir/reports/$it").exists()
            }
            // trace.txt too in a real run; nf-test's own -with-trace moves it to meta/trace.csv.
            ['report.html', 'timeline.html'].each {
                assert path("$outputDir/pipeline_info/$it").exists()
            }
        }
    }

    test("stub: chrom all runs the per-chromosome processes for 25 chromosomes") {
        when {
            params {
                chrom    = "all"
                datasets = "clinvar,gnomad_genomes,gnomad_exomes"
                cache    = "${projectDir}/tests/data/cache"
                outdir   = "$outputDir"
            }
        }
        then {
            def counts = workflow.trace.tasks().countBy { it.name.tokenize(' ')[0].tokenize(':')[-1] }
            def perChrom = ['ENUMERATE', 'MERGE_SITES', 'LOOKUP', 'COLLECT', 'KEYS', 'VALIDATE', 'REACH']
            // gnomAD v4 has no chrM: MT streams v3.1 genomes and no exomes.
            def expected = allProcesses.collectEntries { [it, 1] } +
                perChrom.collectEntries { [it, 25] } + [GNOMAD_SITES: 49]
            assert workflow.success
            assert path("$launchDir/meta/nextflow.log").readLines().any { it ==~ /chromosomes\s*: 1,2,3,.*,22,X,Y,MT/ }
            assert counts == expected
            assert path("$outputDir/harvest/MT.tsv.gz").exists()
            assert path("$outputDir/reports/reach_X.txt").exists()
            assert path("$outputDir/reports/summary.md").exists()
            assert path("$outputDir/index/caid.fst").exists()
        }
    }

    // A local --clinvar_vcf is for an exact rerun: NCBI's .md5 beside it is checked when it is
    // there, and CLINVAR_SITES records the md5 as not checked when it is not.
    test("stub: a local clinvar_vcf without an md5 beside it is accepted") {
        when {
            params {
                def vcf = new File("${outputDir}/clinvar_20261019.vcf.gz")
                vcf.parentFile.mkdirs()
                vcf.bytes = new File("${projectDir}/tests/data/clinvar_mini.vcf.gz").bytes
                chrom       = "21"
                clinvar_vcf = vcf.path
                outdir      = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().count { it.name ==~ /.*CLINVAR_SITES.*/ } == 1
        }
    }

    // BUILD_INDEX opens --genome by the path the launcher sees (the manifest records it), so an
    // object-store URL, or any genome with a work directory in object storage, would fail only
    // after the whole enumeration. settings() refuses it before any task, without touching it.
    test("an s3:// genome is refused at launch") {
        when {
            params {
                chrom  = "21"
                genome = "s3://clingen-test-bucket/genome/GRCh38.bin"
                outdir = "$outputDir"
            }
        }
        then {
            def out = (workflow.stdout + workflow.stderr).join('\n')
            assert workflow.failed
            assert out.contains('--genome s3://clingen-test-bucket/genome/GRCh38.bin: ')
            assert out.contains('leave --genome out and BUILD_GENOME builds the genome')
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("a genome that does not exist is refused at launch") {
        when {
            params {
                chrom  = "21"
                genome = "${outputDir}/no-such-dir/GRCh38.bin"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("--genome ${outputDir}/no-such-dir/GRCh38.bin: no such file")
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("stub: a local genome with its idx is used, not built") {
        when {
            params {
                def bin = new File("${outputDir}/genome/GRCh38.bin")
                bin.parentFile.mkdirs()
                bin.text = ''
                new File("${bin}.idx").text = ''
                chrom  = "21"
                genome = bin.path
                outdir = "$outputDir"
            }
        }
        then {
            def counts = workflow.trace.tasks().countBy { it.name.tokenize(' ')[0].tokenize(':')[-1] }
            assert workflow.success
            assert !counts.containsKey('FETCH_FASTA')
            assert !counts.containsKey('BUILD_GENOME')
            assert counts.BUILD_INDEX == 1
        }
    }

    // gnomAD v4 has no chrM exomes, so MT gets no site list at all: gatherByChrom must still
    // hand MERGE_SITES an empty list for it, or MT would never reach KEYS and the index.
    test("stub: a chromosome with no site lists still reaches MERGE_SITES and the index") {
        when {
            params {
                chrom    = "MT"
                datasets = "gnomad_exomes"
                outdir   = "$outputDir"
            }
        }
        then {
            def counts = workflow.trace.tasks().countBy { it.name.tokenize(' ')[0].tokenize(':')[-1] }
            def expected = (allProcesses - ['GNOMAD_SITES', 'CLINVAR_SITES', 'SPLIT_CACHE']).collectEntries { [it, 1] }
            assert workflow.success
            assert counts == expected
            assert path("$outputDir/harvest/MT.tsv.gz").exists()
            assert path("$outputDir/index/caid.fst").exists()
        }
    }
}
