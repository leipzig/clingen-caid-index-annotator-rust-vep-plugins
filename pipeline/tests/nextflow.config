// Test-only overrides, loaded by nf-test as a -c after ../nextflow.config, so these win
// over the plain process settings there (but not over a withLabel/withName selector).

process {
    // A test that expects a task to fail should fail at once, without the 2 s, 4 s
    // backoff and retries a real run wants against flaky networks.
    errorStrategy = 'terminate'
    maxRetries    = 0
}
