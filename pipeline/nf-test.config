// nf-test settings. Run nf-test from pipeline/: it reads this file from its working
// directory, and each test loads ./nextflow.config from there too.
config {
    testsDir   "tests"
    workDir    ".nf-test"                // git-ignored
    configFile "tests/nextflow.config"   // added as a -c after ./nextflow.config, so it wins
    // host: tasks run clingen-index, curl and awk from PATH, without a container, so the
    // offline tests need no image. `--profile local` replaces it; `--profile +x` appends.
    profile    "host"
    withTrace  true                      // workflow.trace in the tests
    autoSort   true
    requires (
        "nf-test": "0.9.5"
    )
}
