// Index regeneration pipeline: parameters, resources, profiles.
// Every parameter is described (and checked) in nextflow_schema.json; `--help` prints them.

manifest {
    name            = 'clingen-index-regeneration'
    description     = 'Regenerates the ClinGen CA-ID index (caid.fst + manifest.json) from the Registry, ClinVar and gnomAD.'
    version         = '0.1.0'
    nextflowVersion = '!>=26.04.7'   // '!' stops the run on an older Nextflow instead of only warning
}

plugins {
    id 'nf-schema@3.0.0'             // exact pin; 3.x needs Nextflow >= 26.04.0
}

validation {
    logging {
        // A misspelt parameter (--merge-gap for --merge_gap) must stop the run, not be ignored.
        unrecognisedParams = 'error'
    }
    help {
        command = 'nextflow run pipeline -profile local --chrom 21 --outdir results/chr21'
    }
}

// Defaults; nextflow_schema.json gives each one's meaning. The profiles below read some of
// these, and an included config sees only the params defined before it, so params come first.
params {
    // what to regenerate
    chrom              = null        // required: null so the schema's 'required' fires
    regions            = 'pc_exons'
    pad                = 20
    merge_gap          = 5000
    max_window         = 50000
    flank              = 200
    datasets           = 'clinvar'
    include_reference  = false       // true: keep the Registry's reference alleles (HGVS ending '=')
    gnomad_version     = 'latest'
    gnomad_mirror      = 'gcs'
    clinvar_vcf        = 'latest'
    genome             = null        // null: built from UCSC hg38.fa.gz
    cache              = null

    // task sizes
    windows_per_task   = 500
    batch_size         = 2000000
    page_size          = 200000
    split_overlap      = 1000

    // checks and output
    allow_mismatches   = false
    outdir             = 'results'

    // where tasks run
    container          = 'clingen-index:0.1.0'
    slurm_queue        = null
    network_queue      = null
    aws_queue          = null
    aws_region         = 'us-east-1'

    // endpoints (hidden in --help)
    registry_url       = 'https://reg.genome.network'
    gnomad_listing_url = 'https://storage.googleapis.com/storage/v1/b/gcp-public-data--gnomad/o'
    ucsc_base          = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38'
    clinvar_url        = 'https://ftp.ncbi.nlm.nih.gov/pub/clinvar/vcf_GRCh38/clinvar.vcf.gz'   // its md5: the same URL + '.md5'

    // help
    help               = false
    helpFull           = false
    showHidden         = false
}

process {
    container     = params.container
    // pipefail: a download that dies mid-stream (curl | gzip -dc | awk) must fail its task,
    // not hand on a truncated file.
    shell         = ['/bin/bash', '-euo', 'pipefail']
    // Retry twice, after 2 s and 4 s, then stop the run; `-resume` continues it. The Rust
    // Registry client does its own long backoff, and this closure runs in a synchronized
    // launcher method, so the waits stay short.
    errorStrategy = { sleep(Math.pow(2, task.attempt) * 1000 as long); 'retry' }
    maxRetries    = 2

    // Each process has one size label; processes that reach the internet also carry
    // 'network', which sets no resources here but lets the slurm profile route them to
    // --network_queue.
    withLabel: small {
        cpus   = 1
        memory = 2.GB
    }
    withLabel: sort {
        cpus   = 4
        memory = 16.GB
    }
    withLabel: genome {
        memory = 8.GB
    }
    withLabel: build {
        memory = 2.GB
    }
    // Registry etiquette: one request stream per Registry process.
    withName: 'ENUMERATE|LOOKUP' {
        maxForks = 1
    }
}

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
    // Add-on, listed last (the strict parser applies profiles in -profile order):
    // -profile local,host runs the tools from PATH with no container.
    host {
        includeConfig 'conf/host.config'
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true                 // a -resume into the same --outdir rewrites them
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
